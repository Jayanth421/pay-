# ==============================================================================
# CAMPUS DONATION WEBSITE — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase Public API Configuration (Get from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase Server-Only Secret Key (NEVER expose to client; used in Next.js Server & Edge Functions)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Transactional Email Provider (Resend API)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=Campus Donation <onboarding@resend.dev>

# Optional App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
